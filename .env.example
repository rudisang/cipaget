HOST=127.0.0.1
PORT=3000
# Leave empty to use `npm run browser:install` Chromium. Set chrome to use installed Chrome.
BROWSER_CHANNEL=
HEADLESS=true
# Prepare the empty public search form during startup; no company data is prefetched.
BROWSER_PREWARM=true
# Optional same-session HTTP navigation for entity data and batched search submission,
# with ordinary-UI fallback for unsupported layouts. Document downloads keep browser controls.
HYBRID_NAVIGATION=false
# Required for a non-loopback HOST. Clients send Authorization: Bearer <value>.
API_KEY=
# Without an API key the server answers only requests addressed to localhost, 127.0.0.1 or [::1].
# List any other hostnames it may be reached by (comma-separated), for example behind a local proxy.
ALLOWED_HOSTS=
BROWSER_CONCURRENCY=1
# Separate search lane: browser views and queue used only by /v1/search, so searches
# never wait behind entity reads. Each adds one prepared browser view.
SEARCH_CONCURRENCY=1
# Split full lookups across independent read-only views. Total active browser views
# are capped at four across HTTP workers; set 1 for serial traversal.
DETAIL_CONCURRENCY=4
MAX_QUEUE=20
QUEUE_TIMEOUT_MS=30000
OPERATION_TIMEOUT_MS=180000
# Separate document worker and operation deadline; PDF generation can exceed 5 seconds.
DOCUMENT_TIMEOUT_MS=180000
ACTION_TIMEOUT_MS=20000
CACHE_TTL_MS=300000
CACHE_MAX_ENTRIES=100
CACHE_MAX_BYTES=33554432
RATE_LIMIT=60
# How long an observed public company start link is reused to skip the repeat search (default 12 h, 0 disables).
# Every reuse still fetches a fresh company view and verifies its identity; no company data is stored.
ROUTE_CACHE_TTL_MS=43200000
